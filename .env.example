# Optional path to the MT5 terminal executable. Leave blank to use the
# terminal installation registered with the MetaTrader 5 Python package.
MT5_PATH=

# Local persistence paths. Relative paths are resolved from the project root.
LIVE_TRADE_DB_PATH=data/market_data.sqlite3
LIVE_TRADE_LOG_PATH=logs/live_trade.jsonl

# Optional comma-separated symbols for snapshot commands.
LIVE_TRADE_SYMBOLS=EURUSD

# Default number of candles retrieved by the CLI.
LIVE_TRADE_DEFAULT_BARS=200
